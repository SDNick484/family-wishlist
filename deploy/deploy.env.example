# Household defaults baked into dist/setup-wishlist.sh by tools/build_installer.py.
# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
# These only matter on a FIRST install; after that, /etc/conf.d/wishlist on the
# container and the Settings screen in the app are the source of truth.

# Emails that can always add/edit/delete (the address used at the Cloudflare login).
ADMIN_EMAILS=you@example.com,partner@example.com

# Tabs created the first time the app starts.
SEED_PEOPLE=Alex,Sam,Jordan

# Default tab colors by name ("A|B" matches either name). Only fills tabs without a color.
PERSON_COLORS=Alex=#1f4d3a,Sam=#2563eb,Jordan=#c62f3c

# Private feed for one companion service on the LAN (see "How access works" in the README).
# Leave the token empty to turn the feed off. Generate one with: openssl rand -hex 32
FEED_TOKEN=
# Tabs the feed may read and reserve on.
FEED_PEOPLE=Alex,Sam
