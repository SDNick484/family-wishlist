#!/bin/sh
# Family Wish Lists — installer for an Alpine LXC (OpenRC).
# GENERATED by tools/build_installer.py from deploy/setup-wishlist.sh.in — edit the template, not this file.
# Safe to re-run: upgrades the app, keeps the database and /etc/conf.d/wishlist.
#
# First install, optionally override defaults:
#   ADMIN_EMAILS="you@x.com,spouse@x.com" sh setup-wishlist.sh
set -eu

APP_DIR=/opt/wishlist
DATA_DIR=/var/lib/wishlist
CONF=/etc/conf.d/wishlist
SVC_USER=wishlist

[ "$(id -u)" = 0 ] || { echo "Run as root."; exit 1; }

echo "==> Installing packages"
apk add --no-cache python3 py3-flask py3-gunicorn py3-jwt py3-cryptography py3-pillow ca-certificates >/dev/null

echo "==> Service user and folders"
id "$SVC_USER" >/dev/null 2>&1 || adduser -S -D -H -h "$DATA_DIR" -s /sbin/nologin "$SVC_USER"
mkdir -p "$APP_DIR" "$DATA_DIR"

echo "==> Unpacking app to $APP_DIR"
rm -rf "$APP_DIR.new" && mkdir -p "$APP_DIR.new"
base64 -d <<'PAYLOAD_EOF' | tar xzf - -C "$APP_DIR.new"
@@PAYLOAD@@
PAYLOAD_EOF
rm -rf "$APP_DIR.old"
[ -d "$APP_DIR" ] && mv "$APP_DIR" "$APP_DIR.old"
mv "$APP_DIR.new" "$APP_DIR"
rm -rf "$APP_DIR.old"
chown -R root:root "$APP_DIR"
chown -R "$SVC_USER" "$DATA_DIR"
chmod 750 "$DATA_DIR"

if [ ! -f "$CONF" ]; then
  echo "==> Writing $CONF (edit this, then: rc-service wishlist restart)"
  cat > "$CONF" <<EOF
# Family Wish Lists settings. Restart after editing: rc-service wishlist restart

# Port gunicorn listens on.
WISHLIST_PORT=${WISHLIST_PORT:-8766}

# Emails that can always add/edit/delete (must match the Cloudflare Access login email).
ADMIN_EMAILS="${ADMIN_EMAILS:-@@ADMIN_EMAILS@@}"

# Cloudflare Access: team domain and the Access application's AUD tag.
# Zero Trust > Settings > Team name and domain shows the team domain (xxx.cloudflareaccess.com);
# Access controls > Applications > (this app) > Configure > Additional settings shows the AUD tag.
CF_TEAM_DOMAIN="${CF_TEAM_DOMAIN:-}"
CF_AUD="${CF_AUD:-}"

# Requests straight from your LAN (http://<ct-ip>:port, no Cloudflare):
# editor | shopper | none
LAN_ROLE="${LAN_ROLE:-editor}"
# Name shown for LAN users (who added an item, default "who got it").
LAN_NAME="${LAN_NAME:-Home}"

# Tabs created on the very first start only (manage them later in Settings).
SEED_PEOPLE="${SEED_PEOPLE:-@@SEED_PEOPLE@@}"

# Private feed for one companion service on the LAN (GET /api/feed, Authorization: Bearer <token>).
# It shows reservations, purchases and secret ideas, so use a long random secret, e.g.
# head -c 32 /dev/urandom | base64. Empty turns the feed off (every /api/feed path is a 404).
FEED_TOKEN="${FEED_TOKEN:-}"
# Comma list of tab names the feed exposes. Empty: none.
FEED_PEOPLE="${FEED_PEOPLE:-@@FEED_PEOPLE@@}"
EOF
  chmod 640 "$CONF"
else
  echo "==> Keeping existing $CONF"
fi

echo "==> OpenRC service"
cat > /etc/init.d/wishlist <<'EOF'
#!/sbin/openrc-run
name="Family Wish Lists"
description="Family wish list tracker (Flask + gunicorn)"
: ${WISHLIST_PORT:=8766}
command="/usr/bin/gunicorn"
command_args="--preload -w 2 -b 0.0.0.0:${WISHLIST_PORT} --chdir /opt/wishlist --access-logfile - app:app"
command_user="wishlist"
command_background=true
pidfile="/run/wishlist.pid"
output_log="/var/log/wishlist.log"
error_log="/var/log/wishlist.log"

depend() { need net; after firewall; }

start_pre() {
  # Family colors (fill tabs without a color; Settings overrides). Override in /etc/conf.d/wishlist.
  : ${PERSON_COLORS:="@@PERSON_COLORS@@"}
  export DATA_DIR=/var/lib/wishlist ADMIN_EMAILS CF_TEAM_DOMAIN CF_AUD LAN_ROLE LAN_NAME SEED_PEOPLE PERSON_COLORS FEED_TOKEN FEED_PEOPLE
  checkpath -f -o wishlist -m 0640 /var/log/wishlist.log
}
EOF
chmod 755 /etc/init.d/wishlist
rc-update add wishlist default >/dev/null 2>&1 || true
rc-service wishlist restart >/dev/null 2>&1 || rc-service wishlist start

sleep 2
. "$CONF"
if wget -qO- "http://127.0.0.1:${WISHLIST_PORT:-8766}/healthz" 2>/dev/null | grep -q ok; then
  IP=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | head -n1)
  echo
  echo "Wish Lists is running: http://${IP}:${WISHLIST_PORT:-8766}"
  [ -z "${CF_AUD:-}" ] && echo "Cloudflare Access is not configured yet: set CF_TEAM_DOMAIN and CF_AUD in $CONF, then rc-service wishlist restart"
else
  echo "Service didn't answer. Check: tail -n 40 /var/log/wishlist.log"
  exit 1
fi
